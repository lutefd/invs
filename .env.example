# Copy to .env for local overrides. Never commit credentials.
POSTGRES_DB=market_research
POSTGRES_USER=market_research
POSTGRES_PASSWORD=market_research_local

# SEC requires a descriptive User-Agent with contact information.
SEC_USER_AGENT=personal-quant-research/0.1 contact@example.com

# Optional when the configured FRED endpoint requires an API key.
FRED_API_KEY=

