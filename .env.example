# Copy to .env for local overrides. Never commit credentials.
POSTGRES_DB=market_research
POSTGRES_USER=market_research
POSTGRES_PASSWORD=market_research_local

# Optional port overrides; web apps bind locally and to the explicit Tailnet IP only.
INVS_TAILSCALE_IPV4=
POSTGRES_PORT=5432
JUPYTER_PORT=8888
GRAFANA_PORT=3000
STOCK_MANAGER_PORT=8090

# Copy config/config.example.yaml to this untracked file before editing the universe.
INVS_CONFIG_FILE=./config/config.local.yaml

# SEC requires a descriptive User-Agent with contact information.
SEC_USER_AGENT=personal-quant-research/0.1 contact@example.com

# Optional: GIW credentials make the supported authenticated constituent feed
# the default. Without credentials, the temporary public website feed is used.
INVS_NASDAQ_SOURCE=
INVS_NASDAQ_GIW_USERNAME=
INVS_NASDAQ_GIW_PASSWORD=

# Required when providers.alfred is enabled. Keep this environment-only.
FRED_API_KEY=

# Leave blank to let Jupyter generate a per-start token (shown by `make urls`).
JUPYTER_TOKEN=

# Optional health thresholds for a complete daily cycle.
INVS_STALE_AFTER_HOURS=26
INVS_PROJECTION_AFTER_HOURS=26
INVS_DISK_WARN_PERCENT=85
INVS_BACKUP_AFTER_HOURS=30

# Local-only defaults; change the password if the port is forwarded or shared.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
