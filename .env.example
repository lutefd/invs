# Copy to .env for local overrides. Never commit credentials.
POSTGRES_DB=market_research
POSTGRES_USER=market_research
POSTGRES_PASSWORD=market_research_local

# Optional host port overrides. Services bind only to localhost.
POSTGRES_PORT=5432
JUPYTER_PORT=8888
GRAFANA_PORT=3000

# Copy config/config.example.yaml to this untracked file before editing the universe.
INVS_CONFIG_FILE=./config/config.local.yaml

# SEC requires a descriptive User-Agent with contact information.
SEC_USER_AGENT=personal-quant-research/0.1 contact@example.com

# Required when providers.alfred is enabled. Keep this environment-only.
FRED_API_KEY=

# Leave blank to let Jupyter generate a per-start token (shown by `make urls`).
JUPYTER_TOKEN=

# Local-only defaults; change the password if the port is forwarded or shared.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
