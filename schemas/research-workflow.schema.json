{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/research-workflow.schema.json",
  "title": "Integrated research workflow specification",
  "description": "Immutable references and acceptance requirements for one research-to-paper workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "workflow_id",
    "scenario",
    "decision_at",
    "research_report",
    "backtest_report",
    "backtest_experiment_ids",
    "paper_report",
    "paper_account_ids",
    "forward_record",
    "commodity_evidence",
    "limitations"
  ],
  "properties": {
    "$schema": { "const": "../schemas/research-workflow.schema.json" },
    "schema_version": { "const": "1.0.0" },
    "workflow_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "scenario": { "enum": ["thematic", "cross_market"] },
    "decision_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "research_report": { "$ref": "#/$defs/fileRef" },
    "backtest_report": { "$ref": "#/$defs/fileRef" },
    "backtest_experiment_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/uuid" }
    },
    "paper_report": { "$ref": "#/$defs/fileRef" },
    "paper_account_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/uuid" }
    },
    "forward_record": { "$ref": "#/$defs/forwardRecord" },
    "commodity_evidence": {
      "anyOf": [
        { "$ref": "#/$defs/fileRef" },
        { "type": "null" }
      ]
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "forwardRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["genuine", "recorded_replay", "not_started"] },
        "evidence": {
          "anyOf": [
            { "$ref": "#/$defs/fileRef" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
