{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/data-source.schema.json",
  "title": "DataSource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "code", "name", "source_kind", "enabled", "config", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "code": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "source_kind": {
      "$ref": "common.schema.json#/$defs/slug",
      "$comment": "Open vocabulary such as api, regulator, exchange, file_drop, or manual; not a database enum."
    },
    "base_url": { "type": ["string", "null"], "format": "uri" },
    "enabled": { "type": "boolean" },
    "config": { "type": "object" },
    "created_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  }
}
