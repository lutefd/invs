{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/discovery-index.schema.json",
  "title": "Daily stock discovery index",
  "description": "An immutable cross-sectional ranking derived from one validated point-in-time feature batch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "discovery_id", "model", "universe", "market_session", "decision_at", "feature_batch", "policy", "summary", "rows"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "discovery_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "model": { "$ref": "#/$defs/model" },
    "universe": { "$ref": "#/$defs/universe" },
    "market_session": { "$ref": "common.schema.json#/$defs/date" },
    "decision_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "feature_batch": { "$ref": "#/$defs/featureBatch" },
    "policy": { "$ref": "#/$defs/policy" },
    "summary": { "$ref": "#/$defs/summary" },
    "rows": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "decimal": { "$ref": "common.schema.json#/$defs/decimal" },
    "nullableDecimal": { "oneOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "git_commit", "weights"],
      "properties": {
        "name": { "const": "momentum-risk-rank" },
        "version": { "const": "1.0.0" },
        "git_commit": { "oneOf": [{ "pattern": "^[0-9a-f]{40}$" }, { "const": "unknown" }] },
        "weights": {
          "type": "object", "additionalProperties": false,
          "required": ["return_3m", "return_6m", "return_12m", "low_volatility_1m", "shallow_drawdown_1m"],
          "properties": {
            "return_3m": { "const": "0.25" }, "return_6m": { "const": "0.3" },
            "return_12m": { "const": "0.3" }, "low_volatility_1m": { "const": "0.1" },
            "shallow_drawdown_1m": { "const": "0.05" }
          }
        }
      }
    },
    "universe": {
      "type": "object", "additionalProperties": false,
      "required": ["universe_id", "name", "membership_as_of", "fingerprint", "size"],
      "properties": {
        "universe_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "name": { "$ref": "common.schema.json#/$defs/slug" },
        "membership_as_of": { "$ref": "common.schema.json#/$defs/date" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "featureBatch": {
      "type": "object", "additionalProperties": false,
      "required": ["batch_id", "feature_set", "feature_set_version", "input_fingerprint", "manifest_path", "manifest_sha256", "input_fitness"],
      "properties": {
        "batch_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "feature_set": { "const": "market-momentum" },
        "feature_set_version": { "const": "1.0.0" },
        "input_fingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
        "manifest_path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\].*$" },
        "manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "input_fitness": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_count", "purpose", "automatic_trading"],
      "properties": {
        "candidate_count": { "type": "integer", "minimum": 1 },
        "purpose": { "const": "research_watchlist_only" },
        "automatic_trading": { "const": false }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["eligible_count", "rejected_count", "candidate_count"],
      "properties": {
        "eligible_count": { "type": "integer", "minimum": 0 },
        "rejected_count": { "type": "integer", "minimum": 0 },
        "candidate_count": { "type": "integer", "minimum": 0 }
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["return_1m", "return_3m", "return_6m", "return_12m", "realized_volatility_1m", "max_drawdown_1m"],
      "properties": {
        "return_1m": { "$ref": "#/$defs/nullableDecimal" }, "return_3m": { "$ref": "#/$defs/nullableDecimal" },
        "return_6m": { "$ref": "#/$defs/nullableDecimal" }, "return_12m": { "$ref": "#/$defs/nullableDecimal" },
        "realized_volatility_1m": { "$ref": "#/$defs/nullableDecimal" }, "max_drawdown_1m": { "$ref": "#/$defs/nullableDecimal" }
      }
    },
    "components": {
      "type": "object", "additionalProperties": false,
      "required": ["return_3m", "return_6m", "return_12m", "low_volatility_1m", "shallow_drawdown_1m"],
      "properties": {
        "return_3m": { "$ref": "#/$defs/nullableDecimal" }, "return_6m": { "$ref": "#/$defs/nullableDecimal" },
        "return_12m": { "$ref": "#/$defs/nullableDecimal" }, "low_volatility_1m": { "$ref": "#/$defs/nullableDecimal" },
        "shallow_drawdown_1m": { "$ref": "#/$defs/nullableDecimal" }
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "security_id", "ticker", "sector", "candidate", "score", "features", "component_percentiles", "eligibility"],
      "properties": {
        "rank": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "security_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "ticker": { "type": "string", "pattern": "^[A-Z0-9.-]{1,16}$" },
        "sector": { "$ref": "common.schema.json#/$defs/slug" },
        "candidate": { "type": "boolean" },
        "score": { "$ref": "#/$defs/nullableDecimal" },
        "features": { "$ref": "#/$defs/features" },
        "component_percentiles": { "$ref": "#/$defs/components" },
        "eligibility": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reasons"],
          "properties": {
            "status": { "enum": ["eligible", "rejected"] },
            "reasons": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
