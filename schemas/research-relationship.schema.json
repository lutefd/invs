{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/research-relationship.schema.json",
  "title": "Reviewed research relationship revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relationship_id",
    "revision",
    "from_entity_id",
    "to_entity_id",
    "relationship_type",
    "direction",
    "knowledge_kind",
    "confidence",
    "evidence_refs",
    "author_method",
    "valid_from",
    "valid_until",
    "recorded_at",
    "revision_state"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "relationship_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "from_entity_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "to_entity_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "relationship_type": {
      "enum": [
        "SUPPLIES",
        "CUSTOMER_OF",
        "DEPENDS_ON",
        "BENEFITS_FROM",
        "EXPOSED_TO",
        "COMPETES_WITH",
        "CONSUMES",
        "PRODUCES",
        "INDICATOR_FOR"
      ]
    },
    "direction": { "enum": ["forward", "reverse", "bidirectional"] },
    "knowledge_kind": { "enum": ["fact", "interpretation"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "author_method": { "type": "string", "minLength": 1 },
    "valid_from": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "valid_until": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/utcTimestamp" },
        { "type": "null" }
      ]
    },
    "recorded_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "revision_state": { "enum": ["proposed", "reviewed", "superseded", "rejected"] }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sha256", "locator"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "locator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
