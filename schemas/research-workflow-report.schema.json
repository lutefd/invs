{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/research-workflow-report.schema.json",
  "title": "Integrated research workflow report",
  "description": "Content-addressed evidence and acceptance checks for one research-to-paper workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "scenario",
    "decision_at",
    "spec_sha256",
    "status",
    "forward_record_status",
    "evidence",
    "links",
    "checks",
    "fitness",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "workflow_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "scenario": { "enum": ["thematic", "cross_market"] },
    "decision_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "spec_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "status": { "enum": ["passed", "attention", "failed"] },
    "forward_record_status": { "enum": ["genuine", "recorded_replay", "not_started"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_report", "backtest_report", "paper_report", "commodity_evidence"],
      "properties": {
        "research_report": { "$ref": "#/$defs/fileRef" },
        "backtest_report": { "$ref": "#/$defs/fileRef" },
        "paper_report": { "$ref": "#/$defs/fileRef" },
        "commodity_evidence": {
          "anyOf": [
            { "$ref": "#/$defs/fileRef" },
            { "type": "null" }
          ]
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_id",
        "evidence_pack_id",
        "hypothesis_id",
        "prediction_id",
        "experiment_ids",
        "paper_account_ids",
        "regions",
        "strategies"
      ],
      "properties": {
        "theme_id": { "type": ["string", "null"] },
        "evidence_pack_id": { "type": ["string", "null"] },
        "hypothesis_id": { "type": ["string", "null"] },
        "prediction_id": { "type": ["string", "null"] },
        "experiment_ids": { "type": "array", "items": { "type": "string" } },
        "paper_account_ids": { "type": "array", "items": { "type": "string" } },
        "regions": { "type": "array", "items": { "type": "string" } },
        "strategies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "fitness": {
      "type": "array",
      "items": { "$ref": "#/$defs/fitness" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "observed", "required"],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "status": { "enum": ["passed", "attention", "failed"] },
        "observed": { "type": "string", "minLength": 1 },
        "required": { "type": "string", "minLength": 1 }
      }
    },
    "fitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "classification", "source"],
      "properties": {
        "dataset": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": ["backtest_safe", "current_research_only", "installation_replay_only", "unsupported"]
        },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
