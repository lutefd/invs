{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/research-theme-bundle.schema.json",
  "title": "Reviewed research theme seed bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "themes", "entities", "memberships", "relationships", "indicators", "feature_refs", "conditions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "themes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/themeEntry" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "memberships": { "type": "array", "items": { "$ref": "#/$defs/membership" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationshipEntry" } },
    "indicators": { "type": "array", "items": { "$ref": "#/$defs/indicator" } },
    "feature_refs": { "type": "array", "items": { "$ref": "#/$defs/featureRef" } },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sha256", "locator"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stable_key"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "stable_key": { "$ref": "common.schema.json#/$defs/slug" }
      }
    },
    "themeRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme_id", "revision", "parent_theme_id", "name", "knowledge_kind", "review_state", "description", "evidence_refs", "author_method", "recorded_at"],
      "properties": {
        "theme_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "parent_theme_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
        "name": { "type": "string", "minLength": 1 },
        "knowledge_kind": { "enum": ["fact", "interpretation"] },
        "review_state": { "const": "reviewed" },
        "description": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "author_method": { "type": "string", "minLength": 1 },
        "recorded_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
      }
    },
    "themeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "revision"],
      "properties": {
        "theme": { "$ref": "#/$defs/theme" },
        "revision": { "$ref": "#/$defs/themeRevision" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_type", "stable_key", "display_name", "metadata"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "entity_type": { "enum": ["company", "issuer", "security", "indicator", "geography", "provider"] },
        "stable_key": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "issuer_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
        "security_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme_id", "entity_id", "revision", "role", "knowledge_kind", "confidence", "evidence_refs", "author_method", "valid_from", "valid_until", "recorded_at", "revision_state"],
      "properties": {
        "theme_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "entity_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "role": { "type": "string", "minLength": 1 },
        "knowledge_kind": { "enum": ["fact", "interpretation"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "author_method": { "type": "string", "minLength": 1 },
        "valid_from": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
        "valid_until": { "oneOf": [{ "$ref": "common.schema.json#/$defs/utcTimestamp" }, { "type": "null" }] },
        "recorded_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
        "revision_state": { "const": "reviewed" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "$ref": "common.schema.json#/$defs/uuid" } }
    },
    "relationshipRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "revision", "from_entity_id", "to_entity_id", "relationship_type", "direction", "knowledge_kind", "confidence", "evidence_refs", "author_method", "valid_from", "valid_until", "recorded_at", "revision_state"],
      "properties": {
        "relationship_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "from_entity_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "to_entity_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "relationship_type": { "enum": ["SUPPLIES", "CUSTOMER_OF", "DEPENDS_ON", "BENEFITS_FROM", "EXPOSED_TO", "COMPETES_WITH", "CONSUMES", "PRODUCES", "INDICATOR_FOR"] },
        "direction": { "enum": ["forward", "reverse", "bidirectional"] },
        "knowledge_kind": { "enum": ["fact", "interpretation"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "author_method": { "type": "string", "minLength": 1 },
        "valid_from": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
        "valid_until": { "oneOf": [{ "$ref": "common.schema.json#/$defs/utcTimestamp" }, { "type": "null" }] },
        "recorded_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
        "revision_state": { "const": "reviewed" }
      }
    },
    "relationshipEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship", "revision"],
      "properties": {
        "relationship": { "$ref": "#/$defs/relationship" },
        "revision": { "$ref": "#/$defs/relationshipRevision" }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator_id", "theme_id", "indicator_key", "display_name", "source_ref", "evidence_refs", "recorded_at"],
      "properties": {
        "indicator_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "theme_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "indicator_key": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "recorded_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
      }
    },
    "featureRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_ref_id", "theme_id", "feature_set", "feature_set_version", "artifact_ref", "evidence_refs", "recorded_at"],
      "properties": {
        "feature_ref_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "theme_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "feature_set": { "$ref": "common.schema.json#/$defs/slug" },
        "feature_set_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "artifact_ref": { "type": "object", "minProperties": 1 },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "recorded_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "theme_id", "condition_type", "condition", "evidence_refs", "recorded_at"],
      "properties": {
        "condition_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "theme_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "condition_type": { "enum": ["invalidation", "weaken"] },
        "condition": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "recorded_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
      }
    }
  }
}
