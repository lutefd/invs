{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/feature-fundamental-manifest.schema.json",
  "title": "FundamentalGrowthFeatureManifest",
  "description": "The immutable publication manifest for one fundamental-growth feature artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_version", "feature_set", "feature_set_version",
    "feature_names", "security_id", "issuer_id", "taxonomy_mapping_sha256",
    "artifact", "calendar_pin", "decision_at", "input_available_at",
    "computation_delay_seconds", "available_at", "input_fingerprint",
    "selected_input_manifests", "selected_input_parts", "row_count", "parts"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "manifest_version": { "const": "1.1.0" },
    "feature_set": { "const": "fundamental-growth" },
    "feature_set_version": { "const": "1.0.0" },
    "feature_names": { "const": ["revenue", "revenue_growth_yoy", "operating_margin"] },
    "security_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "issuer_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "taxonomy_mapping_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "artifact": { "$ref": "feature-manifest.schema.json#/$defs/artifactMetadata" },
    "calendar_pin": { "$ref": "feature-manifest.schema.json#/$defs/calendarPin" },
    "decision_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "input_available_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "computation_delay_seconds": { "type": "integer", "minimum": 0 },
    "available_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "input_fingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
    "selected_input_manifests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/inputRef" }
    },
    "selected_input_parts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/inputPartRef" }
    },
    "row_count": { "const": 1 },
    "parts": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/outputPart" }
    }
  },
  "$defs": {
    "inputRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "inputPartRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^part-[0-9a-f]{64}\\.parquet$" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "outputPart": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "row_count"],
      "properties": {
        "path": { "type": "string", "pattern": "^part-[0-9a-f]{64}\\.parquet$" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "row_count": { "const": 1 }
      }
    }
  }
}
