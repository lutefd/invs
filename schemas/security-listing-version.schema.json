{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/security-listing-version.schema.json",
  "title": "SecurityListingVersion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "security_id",
    "issuer_id",
    "exchange",
    "mic",
    "currency",
    "primary_listing",
    "valid_from",
    "valid_until",
    "available_at",
    "source_reference",
    "recorded_at",
    "data_source_id",
    "raw_payload_hash",
    "revision"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "security_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "issuer_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "exchange": { "type": "string", "minLength": 1 },
    "mic": { "$ref": "common.schema.json#/$defs/mic" },
    "currency": { "$ref": "common.schema.json#/$defs/currency" },
    "primary_listing": { "type": "boolean" },
    "valid_from": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "valid_until": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/utcTimestamp" }, { "type": "null" }]
    },
    "available_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "source_reference": { "type": "string", "minLength": 1 },
    "recorded_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "data_source_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "raw_payload_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "revision": { "type": "integer", "minimum": 0 }
  }
}
