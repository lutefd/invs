{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/research-theme.schema.json",
  "title": "Reviewed research theme revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "theme_id",
    "revision",
    "key",
    "name",
    "parent_theme_id",
    "knowledge_kind",
    "review_state",
    "description",
    "evidence_refs",
    "author_method",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "theme_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "key": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "parent_theme_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "knowledge_kind": { "enum": ["fact", "interpretation"] },
    "review_state": { "enum": ["draft", "reviewed", "retired"] },
    "description": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "author_method": { "type": "string", "minLength": 1 },
    "recorded_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sha256", "locator"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "locator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
