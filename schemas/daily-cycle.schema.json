{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invs.local/schemas/daily-cycle.schema.json",
  "title": "INVS daily cycle specification",
  "description": "Explicit inputs and stage configuration for one complete local collect-to-paper cycle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "cycle_id",
    "session_date",
    "decision_at",
    "source",
    "run_key",
    "data_root",
    "ledger_root",
    "backup_dir",
    "report_path",
    "log_dir",
    "collection",
    "feature",
    "paper"
  ],
  "properties": {
    "$schema": { "const": "../schemas/daily-cycle.schema.json" },
    "schema_version": { "const": "1.2.0" },
    "cycle_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "session_date": { "type": "string", "format": "date" },
    "decision_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "source": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "run_key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "data_root": { "const": "data" },
    "ledger_root": { "$ref": "#/$defs/relative_path" },
    "backup_dir": { "type": "string", "minLength": 1 },
    "report_path": { "$ref": "#/$defs/relative_path" },
    "log_dir": { "$ref": "#/$defs/relative_path" },
    "collection": { "$ref": "#/$defs/collection" },
    "feature": { "$ref": "#/$defs/feature" },
    "paper": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/paper" }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "const": true } }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "universe",
        "schedule",
        "calendar_pin",
        "registry",
        "taxonomy_registry",
        "security_mappings",
        "feature_set",
        "feature_set_version"
      ],
      "properties": {
        "enabled": { "const": true },
        "universe": { "$ref": "#/$defs/relative_path" },
        "schedule": { "$ref": "#/$defs/relative_path" },
        "calendar_pin": { "$ref": "#/$defs/relative_path" },
        "registry": { "$ref": "#/$defs/relative_path" },
        "taxonomy_registry": { "$ref": "#/$defs/relative_path" },
        "security_mappings": {
          "anyOf": [{ "$ref": "#/$defs/relative_path" }, { "type": "null" }]
        },
        "feature_set": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "feature_set_version": { "$ref": "#/$defs/semver" }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "spec"],
      "properties": {
        "account_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "spec": { "$ref": "#/$defs/relative_path" }
      }
    }
  }
}
