{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/backtest-result.schema.json",
  "title": "Backtest result manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "experiment_id", "experiment_sha256", "engine_version",
    "input_fingerprint", "status", "context", "artifacts", "summary", "metrics"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "result_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "experiment_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "experiment_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "engine_version": { "type": "string", "minLength": 1 },
    "input_fingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
    "status": { "const": "completed" },
    "context": { "$ref": "#/$defs/context" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nav", "holdings", "orders", "fills", "ledger", "metrics"],
      "properties": {
        "nav": { "$ref": "#/$defs/artifact" },
        "holdings": { "$ref": "#/$defs/artifact" },
        "orders": { "$ref": "#/$defs/artifact" },
        "fills": { "$ref": "#/$defs/artifact" },
        "ledger": { "$ref": "#/$defs/artifact" },
        "metrics": { "$ref": "#/$defs/artifact" }
      }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "metrics": { "$ref": "#/$defs/metrics" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\\\u0000].*$",
      "not": { "pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)" }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "row_count"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "row_count": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_count", "holdings_count", "order_count", "fill_count", "ledger_count"],
      "properties": {
        "session_count": { "type": "integer", "minimum": 0 },
        "holdings_count": { "type": "integer", "minimum": 0 },
        "order_count": { "type": "integer", "minimum": 0 },
        "fill_count": { "type": "integer", "minimum": 0 },
        "ledger_count": { "type": "integer", "minimum": 0 },
        "rejected_trade_count": { "type": "integer", "minimum": 0 },
        "holdout_attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "period", "universe", "cost_policy", "metrics_policy", "base_currency", "reporting_currency"],
      "properties": {
        "strategy": { "$ref": "backtest-experiment.schema.json#/$defs/strategy" },
        "period": { "$ref": "backtest-experiment.schema.json#/$defs/dateRange" },
        "universe": { "$ref": "backtest-experiment.schema.json#/$defs/universe" },
        "cost_policy": { "$ref": "backtest-experiment.schema.json#/$defs/costPolicy" },
        "metrics_policy": { "$ref": "backtest-experiment.schema.json#/$defs/metricsPolicy" },
        "base_currency": { "$ref": "common.schema.json#/$defs/currency" },
        "reporting_currency": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/currency" },
            { "type": "null" }
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "metrics_version", "base_currency", "annualization_factor", "risk_free_annual", "metrics_policy", "risk_free_series", "values", "attribution"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "metrics_version": { "const": "1.0.0" },
        "base_currency": { "$ref": "common.schema.json#/$defs/currency" },
        "annualization_factor": { "type": "integer", "minimum": 1 },
        "risk_free_annual": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/decimal" },
            { "type": "null" }
          ]
        },
        "metrics_policy": { "$ref": "backtest-experiment.schema.json#/$defs/metricsPolicy" },
        "risk_free_series": {
          "type": "array",
          "items": { "$ref": "backtest-metrics.schema.json#/$defs/riskFreeSeriesRow" }
        },
        "values": { "type": "object", "minProperties": 1 },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by_partition", "by_year"],
          "properties": {
            "by_partition": {
              "type": "object",
              "additionalProperties": { "$ref": "backtest-metrics.schema.json#/$defs/attributionRow" }
            },
            "by_year": {
              "type": "object",
              "additionalProperties": { "$ref": "backtest-metrics.schema.json#/$defs/attributionRow" }
            }
          }
        }
      }
    }
  }
}
