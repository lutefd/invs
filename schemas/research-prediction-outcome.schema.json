{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/research-prediction-outcome.schema.json",
  "title": "Measured prediction outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome_id",
    "prediction_id",
    "measurement_policy_version",
    "status",
    "realized_result",
    "benchmark_result",
    "drawdown",
    "measured_at",
    "input_artifact_refs"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "outcome_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "prediction_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "measurement_policy_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["measured", "unavailable", "invalid"] },
    "realized_result": { "type": ["object", "null"] },
    "benchmark_result": { "type": ["object", "null"] },
    "drawdown": { "type": ["number", "null"] },
    "measured_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "input_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactRef" }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    }
  }
}
