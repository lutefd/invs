{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/feature-manifest.schema.json",
  "title": "DeterministicFeatureManifest",
  "description": "The immutable publication manifest for one deterministic feature artifact.",
  "$comment": "A manifest is the only reader pointer for a feature artifact. It records the exact selected normalized input manifests and parts, together with the point-in-time build boundary and output part hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_version",
    "feature_set",
    "feature_set_version",
    "feature_names",
    "artifact",
    "decision_at",
    "input_available_at",
    "computation_delay_seconds",
    "available_at",
    "input_fingerprint",
    "selected_input_manifests",
    "selected_input_parts",
    "row_count",
    "parts"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_version": { "const": "1.0.0" },
    "feature_set": { "const": "market-basic" },
    "feature_set_version": { "const": "1.0.0" },
    "feature_names": {
      "const": ["close", "return_1d", "range_1d", "volume"]
    },
    "artifact": { "$ref": "#/$defs/artifactMetadata" },
    "decision_at": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
      "$comment": "The explicit as-of cutoff used to select every input for this artifact. It is never inferred from a trading date or from available_at."
    },
    "input_available_at": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
      "$comment": "The maximum available_at of the selected input rows. It must be no later than decision_at."
    },
    "computation_delay_seconds": {
      "type": "integer",
      "minimum": 0,
      "$comment": "Declared deterministic computation delay in whole seconds. available_at must equal input_available_at plus this duration."
    },
    "available_at": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
      "$comment": "When this feature artifact may be consumed. This is an exact derived timestamp, not a source publication timestamp."
    },
    "input_fingerprint": {
      "$ref": "common.schema.json#/$defs/sha256",
      "$comment": "SHA-256 of the canonical input-selection envelope defined by ADR 0005."
    },
    "selected_input_manifests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/selectedInputManifest" }
    },
    "selected_input_parts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/selectedInputPart" }
    },
    "row_count": {
      "type": "integer",
      "minimum": 0,
      "$comment": "Total number of FeatureObservation rows across parts."
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/featurePart" }
    }
  },
  "$defs": {
    "artifactMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_version",
        "generator_version",
        "git_commit",
        "created_at"
      ],
      "properties": {
        "artifact_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "artifact_version": { "const": "1.0.0" },
        "generator_version": {
          "type": "string",
          "minLength": 1,
          "$comment": "Version of the deterministic feature producer. It is metadata, not permission to reinterpret this contract."
        },
        "git_commit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "const": "unknown" }
          ]
        },
        "created_at": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\\\u0000].*$",
      "$comment": "Relative, non-empty path. The manifest is authoritative; paths are not discovered by recursive globbing."
    },
    "selectedInputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "selectedInputPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^part-[0-9a-f]{64}\\.parquet$",
          "$comment": "The filename is content-named; semantic validation must also require the embedded hash to equal sha256."
        },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "featurePart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "row_count"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^part-[0-9a-f]{64}\\.parquet$",
          "$comment": "The filename must embed the same lowercase SHA-256 as sha256."
        },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "row_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
