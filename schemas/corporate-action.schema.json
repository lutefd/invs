{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/corporate-action.schema.json",
  "title": "CorporateAction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "security_id", "source_event_id", "action_type", "observed_at", "published_at", "effective_at", "provenance"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "security_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "source_event_id": { "type": "string", "minLength": 1 },
    "action_type": {
      "enum": ["split", "reverse_split", "cash_dividend", "stock_dividend", "spinoff", "merger", "acquisition", "delisting", "ticker_change", "exchange_change", "rights_issue", "other"]
    },
    "observed_at": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
      "$comment": "Ex-date or other market observation date associated with the event."
    },
    "published_at": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
      "$comment": "Earliest public announcement of this exact event version."
    },
    "effective_at": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
      "$comment": "When the action legally/economically affects the security."
    },
    "record_date": { "oneOf": [{ "$ref": "common.schema.json#/$defs/date" }, { "type": "null" }] },
    "payment_date": { "oneOf": [{ "$ref": "common.schema.json#/$defs/date" }, { "type": "null" }] },
    "ratio_numerator": { "oneOf": [{ "$ref": "common.schema.json#/$defs/nonNegativeDecimal" }, { "type": "null" }] },
    "ratio_denominator": { "oneOf": [{ "$ref": "common.schema.json#/$defs/nonNegativeDecimal" }, { "type": "null" }] },
    "cash_amount": { "oneOf": [{ "$ref": "common.schema.json#/$defs/nonNegativeDecimal" }, { "type": "null" }] },
    "currency": { "oneOf": [{ "$ref": "common.schema.json#/$defs/currency" }, { "type": "null" }] },
    "target_security_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  }
}
