{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invs.local/backtest-holding.schema.json",
  "title": "Backtest holding row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_date", "security_id", "quantity", "price", "currency", "market_value_local",
    "market_value_base", "position_weight"
  ],
  "properties": {
    "session_date": { "$ref": "common.schema.json#/$defs/date" },
    "security_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "quantity": { "$ref": "common.schema.json#/$defs/nonNegativeDecimal" },
    "price": { "$ref": "common.schema.json#/$defs/nonNegativeDecimal" },
    "currency": { "$ref": "common.schema.json#/$defs/currency" },
    "market_value_local": { "$ref": "common.schema.json#/$defs/nonNegativeDecimal" },
    "market_value_base": { "$ref": "common.schema.json#/$defs/nonNegativeDecimal" },
    "position_weight": { "$ref": "common.schema.json#/$defs/decimal" }
  }
}
